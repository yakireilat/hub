# Phase 1 runs on mock adapters and needs no secrets.
# Later phases add their variables here, one line each with a comment.

# Directory for the SQLite database (phase 2+). On core-01: /mesh/data/hub
HUB_DATA_DIR=./data

# hub.yaml location. Default: $HUB_DATA_DIR/hub.yaml. No file means mock services; a bad file stops the app.
# HUB_CONFIG=./data/hub.yaml

# ntfy access token for the "hub" topic (phase 2). On core-01 it lives in /mesh/data/hub/.env;
# deploy.sh uses it to push "Hub deployed" / "Hub deploy failed".
NTFY_TOKEN=
