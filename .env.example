# Phase 1 runs on mock adapters and needs no secrets.
# Later phases add their variables here, one line each with a comment.

# Directory for the SQLite database (phase 2+). On core-01: /mesh/data/hub
HUB_DATA_DIR=./data

# Service checks: how often (seconds) and how many days of results to keep in hub.db. Defaults: 60 and 7.
# HUB_CHECK_INTERVAL_S=60
# HUB_HISTORY_DAYS=7

# hub.yaml location. Default: $HUB_DATA_DIR/hub.yaml. No file means mock services; a bad file stops the app.
# HUB_CONFIG=./data/hub.yaml

# Tailscale API OAuth client, scope devices:core (read), for online / last-seen on the node tiles.
# Optional: without it the tiles show metrics only.
TS_API_CLIENT_ID=
TS_API_CLIENT_SECRET=

# Notifications go out as Gmail through n8n: the hub POSTs {title, level, message, source} to an n8n
# webhook, and n8n's Gmail node sends it. deploy.sh uses this for "Hub deployed" / "Hub deploy failed".
# On core-01 these live in /mesh/data/hub/.env. Internal URL, reached over the mesh Docker network.
HUB_NOTIFY_WEBHOOK=http://n8n:5678/webhook/hub-notify
# Shared secret the n8n webhook checks in the x-hub-token header (n8n: Header Auth credential).
HUB_NOTIFY_TOKEN=
