# Phase 1 runs on mock adapters and needs no secrets.
# Later phases add their variables here, one line each with a comment.

# Directory for the SQLite database (phase 2+). On core-01: /opt/hub/data
HUB_DATA_DIR=./data

# IANA time zone for times shown in the UI (server-rendered). Defaults to the server zone.
HUB_TZ=
